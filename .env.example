# Server-side credentials. Heritage Bridge reads the repository-root .env.
# Never put credentials in public/, browser code, screenshots, or chat.
QLOO_API_KEY=
QLOO_API_SERVER=https://hackathon.api.qloo.com
# The official Qloo harness requires Node >=22.19 and harness >=0.1.26.
# PORT below belongs to the preserved Tuesday Fix prototype.
PORT=4173

# Heritage Bridge — server reads this repository-root file.
# Leave fixture mode on until you intend to make billable live requests.
HERITAGE_MODE=fixture
HERITAGE_PORT=5181
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
HERITAGE_REQUESTS_PER_MINUTE=12
HERITAGE_DAILY_TOOL_BUDGET=100
HERITAGE_CLIENT_DAILY_REQUESTS=24
HERITAGE_REQUEST_TIMEOUT_MS=120000
HERITAGE_HOST=127.0.0.1
# Deployment: set one HTTPS origin, a persistent private directory, and a secret
# of at least 32 random characters. The platform PORT is used if HERITAGE_PORT is omitted.
HERITAGE_PUBLIC_ORIGIN=
HERITAGE_STATE_DIR=
HERITAGE_SIGNING_SECRET=
# Comma-separated trusted proxy IPs/CIDRs only; leave empty for direct connections.
# Required when a public origin uses a loopback listener behind a reverse proxy.
HERITAGE_TRUST_PROXY=
