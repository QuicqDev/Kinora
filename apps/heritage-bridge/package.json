{
  "name": "kinora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/run.mjs start",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run catalogue:check && npm run build && npm run test",
    "demo:check": "node scripts/run.mjs demo-check",
    "catalogue:check": "tsx scripts/validate-library.ts",
    "coverage:inspect": "node scripts/run.mjs inspect",
    "live:audit": "node scripts/run.mjs audit",
    "live:smoke": "node scripts/run.mjs smoke",
    "live:warm": "node scripts/run.mjs warm",
    "live:profiles": "node scripts/run.mjs profiles"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@google/genai": "2.27.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@qloo/qloo-harness": "0.1.26",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "lucide-react": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "node": "22.23.3",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "undici": "8.10.2"
  },
  "license": "MIT"
}
