{
  "checked": "2026-10-04",
  "harness": "0.1.26",
  "tools": [
    {
      "name": "qloo_capabilities",
      "title": "Inspect Qloo MCP capabilities",
      "description": "Inspect the canonical Qloo workflow contract, checksum, and this server's exact execution readiness without contacting Qloo.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "recommend",
                "rank",
                "describe",
                "where_popular",
                "compare_audiences",
                "entity_tags",
                "audience_demographics",
                "trends",
                "find_tags"
              ]
            },
            "uniqueItems": true,
            "maxItems": 9
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "manifest_schema_version": {
            "type": "string"
          },
          "contract_version": {
            "type": "string"
          },
          "contract_checksum": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "result_schema_version": {
            "type": "string"
          },
          "adapter": {
            "type": "object"
          },
          "operations": {
            "type": "array"
          }
        },
        "required": [
          "manifest_schema_version",
          "contract_version",
          "contract_checksum",
          "result_schema_version",
          "adapter",
          "operations"
        ],
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "qloo/contractVersion": "1.0.0",
        "qloo/contractChecksum": "sha256:762bdcc5e14ff797b6de739d2658a83f78af35e68d7a5a3449455be6046924f5"
      }
    },
    {
      "name": "qloo_rank",
      "title": "Rank a supplied set of options for signals, location, or audience.",
      "description": "Rank one supplied option set against one shared entity, location, demographic, and tag profile. Scores from separate calls are not comparable.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 10,
            "description": "Named entities or Qloo entity UUIDs; use tag fields for abstract concepts."
          },
          "option_type": {
            "type": "string",
            "enum": [
              "artist",
              "book",
              "brand",
              "movie",
              "person",
              "place",
              "podcast",
              "tv_show",
              "videogame"
            ],
            "description": "Qloo Insights entity type: artist, book, brand, movie, person, place, podcast, tv_show, videogame."
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 10,
            "description": "Named entities or Qloo entity UUIDs; use tag fields for abstract concepts."
          },
          "signal_location": {
            "type": "string",
            "minLength": 1
          },
          "demographic": {
            "type": "string",
            "minLength": 1,
            "description": "Audience demographic in natural language, such as 'young women', 'men 25-34', or 'millennials'. It is converted to documented Qloo demographic signals.",
            "examples": [
              "young women",
              "men 25-34",
              "millennials"
            ]
          },
          "include_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 10,
            "description": "Genres, moods, styles, traits, or other concepts, or Qloo tag URNs; not named entities."
          },
          "exclude_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 10,
            "description": "Genres, moods, styles, traits, or other concepts, or Qloo tag URNs; not named entities."
          }
        },
        "required": [
          "options",
          "option_type"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0-preview.1"
          },
          "operation": {
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "const": "ok"
              },
              {
                "type": "string",
                "const": "empty"
              },
              {
                "type": "string",
                "const": "needs_input"
              },
              {
                "type": "string",
                "const": "partial"
              },
              {
                "type": "string",
                "const": "degraded"
              },
              {
                "type": "string",
                "const": "error"
              }
            ]
          },
          "summary": {
            "type": "string"
          },
          "interpretation": {},
          "results": {},
          "result_count": {
            "type": "integer",
            "minimum": 0
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "query_intent": {},
          "error": {
            "type": "object",
            "required": [
              "code",
              "layer",
              "retryable",
              "recovery"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "layer": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "recovery": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "execution": {
            "type": "object",
            "required": [
              "transport",
              "transport_name",
              "correlation_id",
              "duration_ms"
            ],
            "properties": {
              "transport": {
                "type": "string",
                "enum": [
                  "direct",
                  "cli",
                  "mcp"
                ]
              },
              "transport_name": {
                "type": "string"
              },
              "correlation_id": {
                "type": "string"
              },
              "duration_ms": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "required": [
              "source",
              "endpoint",
              "documentation"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "endpoint": {
                "type": "string"
              },
              "documentation": {
                "type": "string"
              },
              "transport": {
                "type": "string"
              },
              "requests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "method",
                    "path",
                    "query"
                  ],
                  "properties": {
                    "method": {
                      "type": "string",
                      "const": "GET"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "query": {}
                  },
                  "additionalProperties": false
                },
                "maxItems": 20
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "schema_version",
          "operation",
          "status",
          "execution"
        ],
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "_meta": {
        "qloo/contractVersion": "1.0.0",
        "qloo/contractChecksum": "sha256:762bdcc5e14ff797b6de739d2658a83f78af35e68d7a5a3449455be6046924f5"
      }
    },
